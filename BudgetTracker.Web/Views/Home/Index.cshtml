@using BudgetTracker

@{
    ViewData["Title"] = "BudgetTracker";
    string? selectedType = Context.Request.Query["type"].ToString();
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">BudgetTracker</h1>
        <p class="text-muted">Hantera dina inkomster och utgifter på ett enkelt sätt.</p>
    </div>

    <!-- Saldo -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <p class="text-muted mb-2">Totalt saldo</p>
            <h2 class="fw-bold mb-0">@ViewBag.Balance kr</h2>
        </div>
    </div>

    <!-- Felmeddelande -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Transaktioner -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">Mina transaktioner</h4>

            <!-- Filtrera transaktioner -->
            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex gap-2 align-items-center mb-4">

                <select name="type" class="form-select" style="max-width: 200px;">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedType))">
                        Alla transaktioner
                    </option>
                    <option value="Income" selected="@(selectedType == "Income")">
                        Inkomster
                    </option>
                    <option value="Expense" selected="@(selectedType == "Expense")">
                        Utgifter
                    </option>
                </select>

                <button type="submit" class="btn btn-primary">
                    Filtrera
                </button>
            </form>

            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Typ</th>
                            <th>Kategori</th>
                            <th>Belopp</th>
                            <th>Redigera transaktion</th>
                            <th>Åtgärd</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (Transaction transaction in ViewBag.Transactions)
                        {
                            <tr>
                                <td>
                                    @if (transaction.Type == TransactionType.Income)
                                    {
                                        <span class="badge bg-success">Inkomst</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Utgift</span>
                                    }
                                </td>

                                <td>@transaction.Category</td>

                                <td class="fw-semibold">
                                    @transaction.Amount kr
                                </td>

                                <td>
                                    <form asp-controller="Home" asp-action="UpdateTransaction" method="post"
                                          class="d-flex gap-2 align-items-center">

                                        <input type="hidden" name="id" value="@transaction.Id" />

                                        <select name="newType" class="form-select form-select-sm" style="min-width: 100px;">

                                            <option value="Income" selected="@(transaction.Type == TransactionType.Income)">
                                                Inkomst
                                            </option>

                                            <option value="Expense"
                                                    selected="@(transaction.Type == TransactionType.Expense)">
                                                Utgift
                                            </option>
                                        </select>

                                        <input type="text" name="newCategory" value="@transaction.Category" required
                                               class="form-control form-control-sm" style="min-width: 110px;" />

                                        <input type="number" name="newAmount" value="@transaction.Amount" step="0.01"
                                               min="0.01" required class="form-control form-control-sm"
                                               style="min-width: 100px;" />

                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            Uppdatera
                                        </button>
                                    </form>
                                </td>

                                <td>
                                    <form asp-controller="Home" asp-action="DeleteTransaction" method="post">

                                        <input type="hidden" name="id" value="@transaction.Id" />

                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Radera
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <!-- Lägg till transaktion -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">Lägg till transaktion</h4>

            <form asp-controller="Home" asp-action="AddTransaction" method="post">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Typ</label>

                        <select name="type" class="form-select">
                            <option value="Income">Inkomst</option>
                            <option value="Expense">Utgift</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Kategori</label>

                        <input type="text" name="category" class="form-control" placeholder="Exempelvis Mat" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Belopp</label>

                        <input type="number" name="amount" step="0.01" min="0.01" class="form-control"
                               placeholder="0.00" required />
                    </div>

                </div>

                <button type="submit" class="btn btn-primary mt-4">
                    Spara transaktion
                </button>

            </form>
        </div>
    </div>

</div>
